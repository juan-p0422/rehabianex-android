<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml"/>
        <exclude domain="sharedpref" path="patient_identity.xml"/>
        <exclude domain="sharedpref" path="supervisor_notification_settings.xml"/>
        <exclude domain="sharedpref" path="rehabianex_notifications.xml"/>
        <exclude domain="sharedpref" path="adaptive_support_state.xml"/>
        <exclude domain="sharedpref" path="rehabianex_fcm_lifecycle.xml"/>
        <exclude domain="sharedpref" path="rehabianex_fcm_delivery_state.xml"/>
        <exclude domain="sharedpref" path="privacy_notice_read_evidence.xml"/>
        <exclude domain="database" path="rehabianex-offline.db"/>
        <exclude domain="database" path="rehabianex-offline.db-shm"/>
        <exclude domain="database" path="rehabianex-offline.db-wal"/>
        <exclude domain="database" path="rehabianex-offline.db-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml"/>
        <exclude domain="sharedpref" path="patient_identity.xml"/>
        <exclude domain="sharedpref" path="supervisor_notification_settings.xml"/>
        <exclude domain="sharedpref" path="rehabianex_notifications.xml"/>
        <exclude domain="sharedpref" path="adaptive_support_state.xml"/>
        <exclude domain="sharedpref" path="rehabianex_fcm_lifecycle.xml"/>
        <exclude domain="sharedpref" path="rehabianex_fcm_delivery_state.xml"/>
        <exclude domain="sharedpref" path="privacy_notice_read_evidence.xml"/>
        <exclude domain="database" path="rehabianex-offline.db"/>
        <exclude domain="database" path="rehabianex-offline.db-shm"/>
        <exclude domain="database" path="rehabianex-offline.db-wal"/>
        <exclude domain="database" path="rehabianex-offline.db-journal"/>
    </device-transfer>
</data-extraction-rules>
